# ============================================================
# Public .htaccess — Front Controller Pattern
# Every request that isn't a real file or folder gets sent
# to index.php so our router can handle it.
# ============================================================

Options -Indexes

RewriteEngine On

# If the request is for a real file (css, js, images) — serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise send everything to index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
