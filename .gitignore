# ============================================================
# Rock County Fitness Hub — .gitignore
# Files and folders Git should NOT track
# ============================================================

# --- User uploaded images (these are binary files, not code) ---
# We keep the folder itself but ignore its contents
public/uploads/*
!public/uploads/.gitkeep

# --- Local-only storage (reset link logs etc.) ---
storage/*
!storage/.gitkeep

# --- PHP config with real credentials (NEVER commit passwords) ---
config/database.local.php

# --- Local-only Claude context file (auto-read by Claude Code) ---
CLAUDE.local.md

# --- OS junk files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / editor folders ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.claude/

# --- PHP error logs ---
*.log
error_log

# --- XAMPP specific ---
/xampp/
